{
  "realm": "eventbank",
  "displayName": "EventBank",
  "enabled": true,
  "loginTheme": "keycloak.v2",
  "emailTheme": "keycloak.v2",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "passwordPolicy": "length(8)",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@eventbank.local",
    "fromDisplayName": "EventBank"
  },
  "roles": {
    "realm": [
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "customer",
        "description": "Uses the bank: accounts, PIX and cards"
      },
      {
        "name": "operator",
        "description": "Reviews applications and watches the platform in the back office"
      },
      {
        "name": "default-roles-eventbank",
        "description": "Roles every new user gets",
        "composite": true,
        "composites": {
          "realm": [
            "customer",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-eventbank"
  },
  "clients": [
    {
      "clientId": "eventbank-web",
      "name": "EventBank web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "eventbank-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eventbank-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "eventbank-cli",
      "name": "EventBank scripts and tests",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "eventbank-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eventbank-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator@eventbank.local",
      "email": "operator@eventbank.local",
      "firstName": "Olivia",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ]
    }
  ]
}
